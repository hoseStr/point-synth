{
  "name": "wheel-synth",
  "private": true,
  "version": "0.1.0",
  "description": "Sintetizador de acordes controlado con las manos por webcam, con dos ruedas (raíz y calidad).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
